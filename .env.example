# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. .env repoya girmez.
# Boş bırakılan bir değişken, onu kullanan servis açılırken hata verir (fail fast).
# Parolalarda tek tırnak (') kullanmayın (MySQL init betiği SQL içinde tırnaklar).
# Rastgele değer üretmek için: openssl rand -base64 32

# --- MySQL (M0) ---
MYSQL_ROOT_PASSWORD=
AUTH_DB_PASSWORD=
CATALOG_DB_PASSWORD=
BOOKING_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
# Bilgisayarınızda 3306 doluysa değiştirin
MYSQL_HOST_PORT=3306

# --- Redis, yalnızca gateway rate limit (M0) ---
REDIS_PASSWORD=

# --- Gateway (M0) ---
# Tarayıcının ve frontend'in bağlandığı tek API portu
GATEWAY_HOST_PORT=8080
# Gateway'e tarayıcıdan istek atabilecek frontend adresleri (virgülle ayrılmış, "*" kullanılmaz)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- JWT, RS256 (M1) ---
# Anahtar çiftini üretin: ./scripts/jwt-anahtar-uret.sh  -> keys/jwt-private.pem, keys/jwt-public.pem
# Bu klasör container'lara salt okunur mount edilir (private key yalnızca auth-service'e).
JWT_KEYS_DIR=./keys

# --- İlk admin hesabı (M1, K36) ---
# Yalnızca sistemde hiç ADMIN yokken açılışta bir kez oluşturulur. Parola en az 8 karakter.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Servisler arası kimlik, servis JWT'si için client secret'lar (M1, planlama §5.5) ---
# clientId servis adıdır (booking-service, payment-service); secret'ı hem çağıran servis hem auth-service bilir.
BOOKING_SERVICE_CLIENT_SECRET=
PAYMENT_SERVICE_CLIENT_SECRET=

# --- TMDB (M2) ---
# https://www.themoviedb.org/settings/api adresinden alınan API Read Access Token (v4)
TMDB_API_TOKEN=

# --- iyzico sandbox (M4, K39) ---
# https://sandbox-merchant.iyzipay.com adresinden alınır; gerçek para hareketi olmaz
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
