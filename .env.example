# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. .env repoya girmez.
# Parolalarda tek tırnak (') kullanmayın (MySQL init betiği SQL içinde tırnaklar).

# --- MySQL ---
MYSQL_ROOT_PASSWORD=
AUTH_DB_PASSWORD=
CATALOG_DB_PASSWORD=
BOOKING_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
# Bilgisayarınızda 3306 doluysa değiştirin
MYSQL_HOST_PORT=3306
